# Copy to $KV_CONFIG/.env with `./kv setup`. Never commit the filled file.
NOTION_TOKEN=
SLACK_BOT_TOKEN=
APIFY_TOKEN=
GMAIL_TOKEN_FILE=/absolute/path/to/gmail-token.json
GOOGLE_CREDENTIALS_FILE=/absolute/path/to/google-service-account.json

# Optional: only needed by adapters or model runners you enable.
ANTHROPIC_API_KEY=
