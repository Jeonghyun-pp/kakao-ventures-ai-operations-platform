# net-sourcing 자격증명 — 이 파일을 .env로 복사해 값 채우기. .env는 커밋·출력 금지.
# 없는 키의 채널은 collect 시 RuntimeError로 친절히 실패하고 다른 채널은 정상 동작.

# Notion 적재(sync)·중복대조 — bplan-automation의 NOTION_TOKEN 재사용.
# ⚠️ 해당 integration을 Notion에서 극초기 DB(ec585ca6…)에 "연결(공유)"해야 200.
# (DB id는 env가 아니라 config.yaml notion.db_id 사용)
NOTION_TOKEN=

# Apify — LinkedIn·X·Threads 공용(쿠키리스 액터). apify.com 계정 토큰.
APIFY_TOKEN=

# 네이버 Open API — developers.naver.com 무료 자가발급(2분), 25,000req/day.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Product Hunt — 무료 developer token(자가발급, 무기한). PH 켤 때만.
PRODUCTHUNT_TOKEN=

# Threads 공식 API(선택, mode=official일 때만). 기본은 Apify.
THREADS_ACCESS_TOKEN=
