<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 매주 화 08:00 (그물망 미팅 하루 전) net-sourcing run --channel all 무인 실행.
     경로는 install 시 사용자 홈으로 치환 필요할 수 있음(현재 절대경로 하드코딩 가정). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kakaoventures.net-sourcing</string>

  <key>ProgramArguments</key>
  <array>
    <string>/home/example/.claude/skills/net-sourcing/project/.venv/bin/python</string>
    <string>/home/example/.claude/skills/net-sourcing/project/main.py</string>
    <string>run</string>
    <string>--channel</string>
    <string>all</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>2</integer>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/home/example/.claude/skills/net-sourcing/project/data/run.log</string>
  <key>StandardErrorPath</key>
  <string>/home/example/.claude/skills/net-sourcing/project/data/run.err.log</string>
</dict>
</plist>
