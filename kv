#!/bin/sh
# kv — 한 입구. `./kv <스킬> <명령…>` 은 그 스킬로, install/check/test 는 루트 스크립트로, 나머지는 ops 로(status·health·digest·backup·retention).
cd "$(dirname "$0")" || exit 1
case "$1" in
  setup) exec .venv/bin/python -m tools.bootstrap ;;
  doctor) exec .venv/bin/python -m tools.doctor ;;
  install) shift; exec .venv/bin/python schedule.py install "$@" ;;
  check) exec .venv/bin/python check_intent.py ;;
  test) exec .venv/bin/python -m unittest discover -s tests -t . ;;
  *) if [ -f "skills/$1/run.py" ]; then s=$1; shift; exec .venv/bin/python -m skills.$s.run "$@"; fi
     exec .venv/bin/python -m skills.ops.run "$@" ;;
esac
