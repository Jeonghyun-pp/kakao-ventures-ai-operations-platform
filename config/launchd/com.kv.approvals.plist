<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  [W8] 승인 리컨실러 — 10분 경량 틱 (fast loop). 무거운 스케줄러(4h, slow loop)와 분리:
  수거·실행은 싸므로 자주, 수집은 비싸므로 드물게 — control-loop frequency 분리.
  idle 이면 1초에 끝난다. 이중 발화는 heavy_slot("approvals") 이 물린다.

  설치:  mkdir -p ~/kv-data/_approvals
        cp config/launchd/com.kv.approvals.plist ~/Library/LaunchAgents/
        launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.kv.approvals.plist
  제거:  launchctl bootout gui/$(id -u)/com.kv.approvals
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kv.approvals</string>
  <key>WorkingDirectory</key><string>/home/example/kv-automation</string>
  <key>ProgramArguments</key>
  <array>
    <string>/home/example/kv-automation/.venv/bin/python</string>
    <string>-m</string><string>kv_core.approvals_tick</string>
  </array>
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/home/example/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>
  <key>StandardOutPath</key><string>/home/example/kv-data/_approvals/launchd.log</string>
  <key>StandardErrorPath</key><string>/home/example/kv-data/_approvals/launchd.log</string>
</dict>
</plist>
